{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kenon",
  "version": "0.1.1",
  "identifier": "org.project-holon.kenon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: kenon: http://kenon.localhost; media-src 'self' kenon: http://kenon.localhost; connect-src 'self' ipc: http://ipc.localhost kenon: http://kenon.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
